# ============================================================
# AI Teacher — Environment Variables
# ============================================================
# Copy this file to .env and fill in values.
# NEVER commit .env to version control.
# ============================================================

# --- Database (PostgreSQL / Supabase) ---
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/ai_teacher

# --- Authentication ---
AUTH_SECRET=change-this-to-a-secure-random-string
AUTH_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- File Storage ---
UPLOAD_DIR=./data/uploads
PROCESSED_DIR=./data/processed

# ============================================================
# PLACEHOLDER — LLM Provider (to be configured later)
# ============================================================
# TODO: Set your LLM API key when provider is selected.
# LLM_PROVIDER=openai
# LLM_API_KEY=
# LLM_MODEL=gpt-4o

# ============================================================
# PLACEHOLDER — Embedding Provider (to be configured later)
# ============================================================
# TODO: Set your embedding API key when provider is selected.
# EMBEDDING_API_KEY=
# EMBEDDING_MODEL=text-embedding-3-small

# ============================================================
# PLACEHOLDER — Vector Database (to be configured later)
# ============================================================
# TODO: Set vector DB connection when provider is selected.
# VECTOR_DB_URL=
# VECTOR_DB_KEY=

# ============================================================
# PLACEHOLDER — TTS Provider (to be configured later)
# ============================================================
# TODO: Set your TTS API key when provider is selected (e.g., ElevenLabs).
# TTS_PROVIDER=elevenlabs
# TTS_API_KEY=
# TTS_VOICE_ID=

# ============================================================
# PLACEHOLDER — Avatar Provider (to be configured later)
# ============================================================
# TODO: Set your avatar API key when provider is selected (e.g., HeyGen, D-ID).
# AVATAR_PROVIDER=heygen
# AVATAR_API_KEY=

# ============================================================
# PLACEHOLDER — Additional Storage (to be configured later)
# ============================================================
# STORAGE_URL=
